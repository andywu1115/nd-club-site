# Copy this file to .env.local and fill in the real value.
# .env.local is gitignored. Never commit a real key.
#
# This is the club's shared Tripo developer key. Ask Andy for it.
# It is read only on the server, in app/api/tripo/*. Do not prefix it with
# NEXT_PUBLIC_ or it will be shipped to every visitor's browser.
TRIPO_API_KEY=
